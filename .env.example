# Supabase do octo-dash2 (leitura anônima via views portal_*). anon key é pública por design.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # anon key (JWT legacy 'eyJ')
# Tenant fixo Lotus ("Japi Lançamentos")
NEXT_PUBLIC_TENANT_ID=65c69875-dc83-4062-90f6-6f6adc30df26

# Segredo do /api/revalidate (o trigger/edge function do Supabase envia no header x-revalidate-secret)
REVALIDATE_SECRET=troque-por-um-segredo-forte

# Dominio do portal (para og:image/canonical). Define no deploy o dominio final.
NEXT_PUBLIC_SITE_URL=https://www.lotusbrokers.com.br

# Indexacao (lib/indexacao.mjs): controla meta robots, robots.txt e X-Robots-Tag.
# Sem a variavel, so o build de producao no dominio oficial indexa; next dev e
# qualquer outro dominio ficam em noindex. Em staging/preview, defina false.
# Lida no build: mudar o valor exige novo deploy. Nunca defina false em producao.
# SITE_INDEXABLE=false

# LIA — atendente de lançamentos (chat do portal). SERVER-SIDE ONLY: sem
# NEXT_PUBLIC_, senão a chave vaza no bundle. Usadas só em app/api/chat/route.ts.
# Repo é público: URL e chave reais só no .env.local / nas envs do deploy.
LIA_API_URL=http://<host-da-lia>:<porta>/lia/chat
LIA_API_KEY=peca-pelo-canal-privado

# LIA — webhook de leads dos formulários das landings. SERVER-SIDE ONLY: sem
# NEXT_PUBLIC_, senão o segredo vaza no bundle e qualquer um injeta lead no CRM.
# Usadas só em app/api/lead/route.ts. Repo é público: valores reais só no
# .env.local e nas envs do deploy.
LIA_LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Medição (briefing 8h, Parte 1). Públicos por natureza (vão no bundle). Vazios =
# nada carrega. GTM já carrega a tag GA4 Configuration (Measurement ID fica no GTM).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
