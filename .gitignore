# Next.js / Node — NUNCA versionar (a raiz do repo é servida pelo GitHub Pages;
# node_modules e .next não podem vazar para o deploy estático).
/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# env locais (a anon key vai em .env.local; NÃO commitar)
.env*.local
.env.local
# env.download traz REVALIDATE_SECRET real — não pode ir para o repositório.
# (.env.example, com placeholders, continua versionado.)
env.download

# Dados do UTM Manager quando UTM_DATA_DIR não está definida (ver
# docs/utm-manager.md): importações e histórico da equipe, não código.
/.dados/

# logs / OS
npm-debug.log*
.DS_Store

# permissões locais do Claude Code (contém caminhos da máquina do dev)
.claude/settings.local.json

# scratch do subagent-driven-development (ledger, briefs, relatórios de review)
.superpowers/

# Artefatos de dev / documentacao local (nao versionar)
FINALIZAR.MD
.playwright-mcp/
# Material de referência das landings (HTMLs exportados do Wix + PDFs/books):
# ~155MB de fonte usada para recriar as páginas. Fica local, fora do repo.
/htmls/
/pdf/
# Screenshots de auditoria/QA na RAIZ do repo (os assets de produção vivem em public/)
/*.png
/Landing Pages/

# Retratos de auditoria gerados sob demanda (dados do dashboard).
# Entregues direto para a Lotus; versionar so guardaria dado desatualizado.
auditoria-*.csv

# Scripts de verificacao gerados durante o trabalho (Chrome via CDP).
.tmp-*
